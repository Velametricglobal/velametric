# ============================================================================
# VELAMETRIC GLOBAL — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env for local development or enter these keys into
# Hostinger -> Deployments -> Environment Variables.
# NEVER commit your production secret values to Git!

# 1. Supabase Database & Auth (Client-Safe Anon Keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Fallback names accepted by Hostinger & Supabase client:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_API_KEY=your-supabase-anon-public-key

# 2. Production Domain
VITE_APP_URL=https://velametric.com

# 3. Currency / Region
VITE_DEFAULT_CURRENCY=INR

# 4. Optional Payment Gateway Keys (₹250/mo Subscription & Invoices)
VITE_RAZORPAY_KEY_ID=
VITE_CASHFREE_APP_ID=

# 5. Production Server Settings
PORT=3000
NODE_ENV=production
