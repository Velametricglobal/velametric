# ============================================================================
# VELA METRIC — ENVIRONMENT VARIABLES TEMPLATE (PRODUCTION / STAGING)
# ============================================================================
# Copy this file to .env.local for local development.
# NEVER commit your actual .env or .env.local file to Git!

# 1. Supabase Public Config (Safe for browser client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Production Domain
VITE_APP_URL=https://velametric.com

# 3. Currency / Locale Default
VITE_DEFAULT_CURRENCY=INR
